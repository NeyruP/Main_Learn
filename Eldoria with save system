def main():
    for l in LORE_INTRO:
        slow_print(l)
    choice = input('1.Novo 2.Load ')
    p = None
    if choice == '2':
        p = load_game()
    if not p:
        name = input('Nome: ')
        p = Player(name)

    while p.health > 0:
        p.display_status()
        print('\n1.Ferreiro 2.Alquimista 3.Guilda 4.Dungeon 5.Save 6.Sair')
        op = input('> ')
        if op == '1':
            blacksmith(p)
        elif op == '2':
            alchemist(p)
        elif op == '3':
            guild(p)
        elif op == '4':
            dungeon(p)
        elif op == '5':
            fname = save_game(p)
            if fname:
                print('Deseja baixar o save agora? 1.Sim 2.Não')
                if input('> ') == '1':
                    serve_file_for_download(fname, timeout=60)
        elif op == '6':
            if input('Deseja salvar antes de sair? 1.Sim 2.Não > ') == '1':
                fname = save_game(p)
                if fname:
                    print('Deseja baixar o save agora? 1.Sim 2.Não')
                    if input('> ') == '1':
                        serve_file_for_download(fname, timeout=60)
            break

if __name__ == '__main__':
    main()
